<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.system.mapper.SysVideoMapper">

    <resultMap type="SysVideo" id="SysVideoResult">
        <result property="id"    column="id"    />
        <result property="videoName"    column="video_name"    />
        <result property="videoType"    column="video_type"    />
        <result property="videoSrc"    column="video_src"    />
        <result property="imgPath"    column="img_path"    />
        <result property="position"    column="position"    />
        <result property="description"    column="description"    />
        <result property="status"    column="status"    />
        <result property="dataVolume"    column="data_volume"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectSysVideoVo">
        select id, video_name, video_type, video_src, img_path, position, description, data_volume, status, create_by, create_time, update_by, update_time, remark from sys_video where status > 0
    </sql>

    <select id="selectSysVideoList" parameterType="SysVideo" resultMap="SysVideoResult">
        <include refid="selectSysVideoVo"/>
        <where>
            <if test="videoName != null  and videoName != ''"> and video_name like concat('%', #{videoName}, '%')</if>
            <if test="videoType != null  and videoType != ''"> and video_type = #{videoType}</if>
            <if test="videoSrc != null  and videoSrc != ''"> and video_src = #{videoSrc}</if>
            <if test="imgPath != null  and imgPath != ''"> and img_path = #{imgPath}</if>
            <if test="position != null  and position != ''"> and position = #{position}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="dataVolume != null  and dataVolume != ''"> and data_volume = #{dataVolume}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="remark != null  and remark != ''"> and remark = #{remark}</if>
        </where>
    </select>

    <select id="selectSysVideoById" parameterType="Long" resultMap="SysVideoResult">
        <include refid="selectSysVideoVo"/>
        and id = #{id}
    </select>

    <select id="selectSysVideoListByType" parameterType="Long" resultMap="SysVideoResult">
        <include refid="selectSysVideoVo"/>
        and video_type = #{type}
    </select>

    <insert id="insertSysVideo" parameterType="SysVideo" useGeneratedKeys="true" keyProperty="id">
        insert into sys_video
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="videoName != null">video_name,</if>
            <if test="videoType != null">video_type,</if>
            <if test="videoSrc != null">video_src,</if>
            <if test="imgPath != null">img_path,</if>
            <if test="position != null">position,</if>
            <if test="description != null">description,</if>
            <if test="dataVolume != null">data_volume,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="videoName != null">#{videoName},</if>
            <if test="videoType != null">#{videoType},</if>
            <if test="videoSrc != null">#{videoSrc},</if>
            <if test="imgPath != null">#{imgPath},</if>
            <if test="position != null">#{position},</if>
            <if test="description != null">#{description},</if>
            <if test="dataVolume != null">#{dataVolume},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysVideo" parameterType="SysVideo">
        update sys_video
        <trim prefix="SET" suffixOverrides=",">
            <if test="videoName != null">video_name = #{videoName},</if>
            <if test="videoType != null">video_type = #{videoType},</if>
            <if test="videoSrc != null">video_src = #{videoSrc},</if>
            <if test="imgPath != null">img_path = #{imgPath},</if>
            <if test="position != null">position = #{position},</if>
            <if test="description != null">description = #{description},</if>
            <if test="dataVolume != null">data_volume = #{dataVolume},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysVideoById" parameterType="Long">
        delete from sys_video where id = #{id}
    </delete>

    <delete id="deleteSysVideoByIds" parameterType="String">
        update sys_video set status = 0 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
