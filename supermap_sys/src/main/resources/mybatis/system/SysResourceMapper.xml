<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.project.system.mapper.SysResourceMapper">

    <resultMap type="SysResource" id="SysResourceResult">
        <result property="resourceId"    column="resource_id"    />
        <result property="parentId"    column="parent_id"    />
        <result property="nodeName"    column="node_name"    />
        <result property="nodeType"    column="node_type"    />
        <result property="dataType"    column="data_type"    />
        <result property="serverUrl"    column="server_url"    />
        <result property="dataServerUrl"    column="data_server_url" />
        <result property="orderBy"    column="order_by"    />
        <result property="nodeStatus"    column="node_status"    />
        <result property="legend"    column="legend"    />
        <result property="layerSearch"    column="layer_search"    />
        <result property="queryPara"    column="query_para"    />
        <result property="parentCode"    column="parent_code"    />
        <result property="childNames"    column="child_names"    />
        <result property="dataYear"    column="data_year"    />
        <result property="dataVolume"    column="data_volume"    />
        <result property="dataParam"    column="data_param"    />
        <result property="dataSource"    column="data_source"    />
        <result property="dataSet"    column="data_set"    />
        <result property="position"    column="position"    />
        <result property="createDate"    column="create_date"    />
        <result property="updateDate"    column="update_date"    />
        <result property="updateBy"    column="update_by"    />
        <result property="bindArea"    column="bind_area"    />
        <result property="dataRegion"    column="data_region"    />
        <result property="remark"    column="remark" />
    </resultMap>

    <resultMap id="SysResourceGroupResult" type="SysGroup">
        <result property="dataRegion"    column="data_region"    />
        <result property="dictLabel"    column="dict_label"    />
        <result property="nodeStatus"    column="node_status"    />
        <result property="num"    column="num"    />
    </resultMap>

    <resultMap type="String" id="SysResourceYearResult">
        <result property="dataYear"    column="data_year"    />
    </resultMap>

    <resultMap type="SysImgCode" id="SourcesCodeResult">
        <result property="id"    column="id"    />
        <result property="codeId"    column="code_id"    />
        <result property="name"    column="name"    />
    </resultMap>

    <sql id="selectImgCodeVo">
        select id, code_id, name from sys_img_code
    </sql>
    <select id="selectPictureAddress" parameterType="SysImgCode" resultMap="SourcesCodeResult">
        select id, code_id, name from sys_img_code where code_id = #{codeId}
    </select>

    <!-- 前端列表 -->
    <sql id="selectSysResourceVo">
        select resource_id, parent_id, node_name, node_type, data_type, server_url, data_server_url, order_by, node_status, legend, layer_search, query_para, child_names, data_year, data_volume, data_source, data_set, data_param, position,parent_code, create_date, update_date, update_by, bind_area, data_region,height, remark from sys_resource where node_status > 1
    </sql>

    <!--前端分权限展示列表-->
    <select id="selectSysRoleResourceList" parameterType="String" resultMap="SysResourceResult">
        select * from sys_resource where authority_role_id like concat('%', #{role}, '%') and node_status > 1
    </select>

    <!--管理系统列表-->
    <select id="selectSysResourceList" parameterType="SysResource" resultMap="SysResourceResult">
        select * from sys_resource where node_status > 0 ORDER BY order_by ASC
    </select>

    <select id="selectSysResourceListByTree" resultMap="SysResourceResult">
        <include refid="selectSysResourceVo"/> ORDER BY order_by ASC
    </select>

    <select id="selectSysResourceListByLeaf" resultMap="SysResourceResult">
        <include refid="selectSysResourceVo"/>
        and node_type > 0
    </select>


