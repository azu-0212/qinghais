    <!-- <select id="selectSysResourceByDataType" parameterType="Long" resultMap="SysResourceResult">
         <include refid="selectSysResourceVo"/>
         AND parent_code = #{typeCode} OR parent_id = (SELECT resource_id FROM sys_resource WHERE parent_code = #{typeCode})
         /*AND parent_code = #{typeCode} or  parent_id = (select resource_id from sys_resource where parent_code = #{typeCode}) or
         parent_id in (select resource_id from sys_resource where parent_id = (select resource_id from sys_resource where parent_code = #{typeCode}))*/
     </select>-->

    <select id="selectSysResourceByDataType" parameterType="Long" resultMap="SysResourceResult">
        <include refid="selectSysResourceVo"/>
        AND parent_code = #{typeCode} OR parent_id = (SELECT resource_id FROM sys_resource WHERE parent_code = #{typeCode}) AND node_status > 1 ORDER BY order_by DESC
    </select>

    <!-- 三级树结构查询 -->
    <select id="selectSysResourceByDataTypeTree" parameterType="Long" resultMap="SysResourceResult">
       select resource_id, parent_id, node_name, node_type, data_type, data_server_url, server_url, order_by, node_status, legend, layer_search,
query_para, child_names, data_year, data_volume, data_param, position,parent_code, create_date, update_date, update_by, data_source, data_set, bind_area, data_region, remark from sys_resource where node_status > 1
       AND parent_code = #{typeCode} or
       parent_id = (select resource_id from sys_resource where parent_code = #{typeCode} and node_status > 1) and node_status > 1 or
       parent_id in (select resource_id from sys_resource where parent_id = (select resource_id from sys_resource where parent_code = #{typeCode} and node_status > 1) and node_status > 1) and node_status > 1
   </select>

    <select id="selectSysResourceByType" parameterType="Long" resultMap="SysResourceResult">
        <include refid="selectSysResourceVo"/>
        AND data_type = #{dataType}
    </select>

    <!-- 按区域分组查询 累计个数  街景的图表统计 -->
    <select id="selectSysResourceRegionByGroup" parameterType="Long" resultMap="SysResourceGroupResult">
        select region.*,sd.dict_label from(select data_region, COUNT(*) as num from sys_resource where data_type = #{dataType} AND node_status > 1 GROUP BY data_region) region
        LEFT JOIN sys_dict_data sd ON sd.dict_value = region.data_region where dict_type = 'sys_region_type'
    </select>

    <!-- 按区域年份分组查询 倾斜摄影的图表统计 -->
    <select id="selectSysResourceRegionYearByGroup" parameterType="SysResource" resultMap="SysResourceGroupResult">
        select region.*,sd.dict_label from(select data_region, COUNT(*) as num from sys_resource where data_type = #{dataType} AND data_year = #{dataYear} AND node_status > 1 GROUP BY data_region) region
        LEFT JOIN sys_dict_data sd ON sd.dict_value = region.data_region where dict_type = 'sys_region_type'
    </select>

    <!-- 按区域分组查询 累计体量 -->
    <select id="selectSysResourceStreetByGroup" parameterType="Long" resultMap="SysResourceGroupResult">
        select region.*,sd.dict_label from(select data_region, sum(data_volume) as num from sys_resource where data_type = #{dataType} AND node_status > 1 GROUP BY data_region) region
        LEFT JOIN sys_dict_data sd ON sd.dict_value = region.data_region where dict_type = 'sys_region_type'
    </select>

    <select id="selectSysResourceByDataTypeYear" parameterType="Long" resultMap="SysResourceResult">
        <include refid="selectSysResourceVo"/>
        AND data_type = #{dataType} AND data_year = #{year} ORDER BY data_year DESC
    </select>

    <select id="selectSysResourceByDataYear" parameterType="Long" resultMap="SysResourceYearResult">
        select DISTINCT data_year from sys_resource where data_type = #{dataType}  ORDER BY data_year DESC
    </select>

    <select id="selectSysResourceById" parameterType="Long" resultMap="SysResourceResult">
        select resource_id, parent_id, node_name, node_type, data_type, server_url, data_server_url, order_by, node_status, legend, layer_search, query_para, child_names, data_year, data_volume, data_source, data_set, data_param, position,parent_code, create_date, update_date, update_by, bind_area, data_region,height, remark
        from sys_resource where resource_id = #{resourceId}
    </select>

    <insert id="insertSysResource" parameterType="SysResource" useGeneratedKeys="true" keyProperty="resourceId">
        insert into sys_resource
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="nodeName != null">node_name,</if>
            <if test="nodeType != null">node_type,</if>
            <if test="dataType != null">data_type,</if>
            <if test="serverUrl != null">server_url,</if>
            <if test="dataServerUrl != null">data_server_url,</if>
            <if test="orderBy != null">order_by,</if>
            <if test="nodeStatus != null">node_status,</if>
            <if test="legend != null">legend,</if>
            <if test="layerSearch != null">layer_search,</if>
            <if test="queryPara != null">query_para,</if>
            <if test="childNames != null and childNames != ''">child_names,</if>
            <if test="parentCode != null">parent_code,</if>
            <if test="dataYear != null">data_year,</if>
            <if test="dataVolume != null">data_volume,</if>
            <if test="dataParam != null">data_param,</if>
            <if test="position != null">position,</if>
            <if test="createDate != null">create_date,</if>
            <if test="updateDate != null">update_date,</if>
            <if test="dataSource != null">data_source,</if>
            <if test="dataSet != null">data_set,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="bindArea != null">bind_area,</if>
            <if test="dataRegion != null">data_region,</if>
            <if test="height != null">height,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="nodeName != null">#{nodeName},</if>
            <if test="nodeType != null">#{nodeType},</if>
            <if test="dataType != null">#{dataType},</if>
            <if test="serverUrl != null">#{serverUrl},</if>
            <if test="dataServerUrl != null">#{dataServerUrl},</if>
            <if test="orderBy != null">#{orderBy},</if>
            <if test="nodeStatus != null">#{nodeStatus},</if>
            <if test="legend != null">#{legend},</if>
            <if test="layerSearch != null">#{layerSearch},</if>
            <if test="queryPara != null">#{queryPara},</if>
            <if test="childNames != null and childNames != ''">#{childNames},</if>
            <if test="dataYear != null">#{dataYear},</if>
            <if test="parentCode != null">#{parentCode},</if>
            <if test="dataVolume != null">#{dataVolume},</if>
            <if test="dataParam != null">#{dataParam},</if>
            <if test="position != null">#{position},</if>
            <if test="createDate != null">#{createDate},</if>
            <if test="dataSource != null">#{dataSource},</if>
            <if test="dataSet != null">#{dataSet},</if>
            <if test="updateDate != null">#{updateDate},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="bindArea != null">#{bindArea},</if>
            <if test="dataRegion != null">#{dataRegion},</if>
            <if test="height != null">#{height},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysResource" parameterType="SysResource">
        update sys_resource
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="nodeName != null">node_name = #{nodeName},</if>
            <if test="nodeType != null">node_type = #{nodeType},</if>
            <if test="dataType != null">data_type = #{dataType},</if>
            <if test="serverUrl != null">server_url = #{serverUrl},</if>
            <if test="dataServerUrl != null">data_server_url = #{dataServerUrl},</if>
            <if test="orderBy != null">order_by = #{orderBy},</if>
            <if test="nodeStatus != null">node_status = #{nodeStatus},</if>
            <if test="legend != null">legend = #{legend},</if>
            <if test="layerSearch != null">layer_search = #{layerSearch},</if>
            <if test="queryPara != null">query_para = #{queryPara},</if>
            <if test="childNames != null and childNames != ''">child_names = #{childNames},</if>
            <if test="dataYear != null">data_year = #{dataYear},</if>
            <if test="dataVolume != null">data_volume = #{dataVolume},</if>
            <if test="dataParam != null">data_param = #{dataParam},</if>
            <if test="parentCode != null">parent_code = #{parentCode},</if>
            <if test="position != null">position = #{position},</if>
            <if test="createDate != null">create_date = #{createDate},</if>
            <if test="dataSource != null">data_source = #{dataSource},</if>
            <if test="dataSet != null">data_set = #{dataSet},</if>
            <if test="updateDate != null">update_date = #{updateDate},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="bindArea != null">bind_area = #{bindArea},</if>
            <if test="dataRegion != null">data_region = #{dataRegion},</if>
            <if test="height != null">height = #{height},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where resource_id = #{resourceId}
    </update>

    <update id="updateSysResourceStatus" parameterType="Long">
        update sys_resource set node_status = #{status} where resource_id = #{resourceId}
    </update>

    <!--清空历史分配-->
    <update id="deleteAssignRoles" parameterType="String">
        update sys_resource set authority_role_id = replace(authority_role_id,#{roleType},'');
    </update>

    <update id="updateResourceAssignRoles" parameterType="com.ruoyi.project.system.domain.SysResourceRole">
        update sys_resource set authority_role_id = concat( #{roleType} ,authority_role_id) where resource_id in
        <foreach item="resourceAutoIds" collection="resourceAutoIds" open="(" separator="," close=")">
            #{resourceAutoIds}
        </foreach>
    </update>

    <delete id="deleteSysResourceById" parameterType="Long">
        update sys_resource set node_status = 0 where resource_id = #{resourceId}
    </delete>

    <delete id="deleteSysResourceByIds" parameterType="String">
        update sys_resource set node_status = 0  where resource_id in
        <foreach item="resourceId" collection="array" open="(" separator="," close=")">
            #{resourceId}
        </foreach>
    </delete>

</mapper>
